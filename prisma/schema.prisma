// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String?   @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  avatar                String?
  password              String?   // For email/password authentication (hashed)
  resetPasswordToken    String?   // Token for password reset
  resetPasswordExpires  DateTime? // Expiration time for reset token
  subscriptionTier      String    @default("free") // free, premium
  workEnvironment       String?   // office, home, flexible, student, gaming, other
  dailySittingHours     Int?      // 2-14 hours
  painAreas             String?   // JSON array of pain areas
  workSchedule          String?   // JSON object with work hours and preferences
  userGoals             String?   // JSON object with user goals
  calibrationData       String?   // JSON object with posture baseline
  qrPairingCode         String?   @unique
  mobileDeviceId        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  postureSessions   PostureSession[]
  breakSessions     BreakSession[]
  achievements      UserAchievement[]
  goals             Goal[]
  workstations      Workstation[]
  dailyStats        DailyStats[]
  pairedDevices     PairedDevice[]
  subscriptions     Subscription[]
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeSubscriptionId String   @unique
  stripePriceId        String
  stripeCustomerId     String
  status               String   // active, canceled, past_due, trialing
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PostureSession {
  id                  String   @id @default(cuid())
  userId              String
  workstationId       String?  // optional: which workstation was used
  startTime           DateTime
  endTime             DateTime?
  duration            Int?     // in minutes
  overallScore        Int?     // 0-100
  goodPosturePercent  Float?   // percentage
  deviationBreakdown  String?  // JSON object with time in each quality category
  alertsReceived      Int?     // number of alerts
  correctionSpeed     Float?   // average time to correct in seconds
  pointsEarned        Int?
  bonusPoints         Int?     // bonus points for achievements

  // Detailed metrics
  timeExcellent       Int?     // seconds in excellent posture
  timeGood            Int?     // seconds in good posture
  timeFair            Int?     // seconds in fair posture
  timePoor            Int?     // seconds in poor posture

  // Alert breakdown
  postureAlerts       Int?     // number of posture correction alerts
  breakReminders      Int?     // number of break reminders

  // Problem areas tracking
  problemAreas        String?  // JSON object with frequency by body part
  mostCommonIssue     String?  // most frequent deviation type

  // Posture quality timeline
  postureTimeline     String?  // JSON array of {timestamp, score} for graph

  // Personal records
  longestGoodStreak   Int?     // longest continuous good posture in seconds
  isPersonalRecord    Boolean  @default(false)
  recordType          String?  // type of record if applicable

  // Environmental factors
  avgScreenDistance   Float?   // average distance from screen in cm
  lightingQuality     String?  // good/fair/poor

  // AI insights
  aiInsights          String?  // JSON array of personalized insights
  recommendations     String?  // JSON array of action recommendations

  mobileSynced        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workstation         Workstation? @relation(fields: [workstationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workstationId])
  @@index([startTime])
  @@index([userId, startTime])
}

model BreakSession {
  id            String   @id @default(cuid())
  userId        String
  breakType     String   // micro, standard, extended
  exercises     String?  // JSON array of completed exercises
  duration      Int?     // in minutes
  completed     Boolean  @default(false)
  pointsEarned  Int?
  mobileSynced  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Exercise {
  id          String   @id @default(cuid())
  name        String
  category    String   // neck, shoulder, back, chest, lower_body, eye
  description String?
  instructions String? // JSON array of steps
  duration    Int?     // in seconds
  difficulty  String   // gentle, moderate, deep
  imageUrl    String?
  gifUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String?
  points      Int?
  rarity      String   // common, rare, legendary
  condition   String?  // JSON object describing unlock condition
  createdAt   DateTime @default(now())
  
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  targetValue Float?
  currentValue Float?  @default(0)
  unit        String?  // percentage, days, points, etc.
  deadline    DateTime?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isCompleted])
  @@index([deadline])
}

model Workstation {
  id              String   @id @default(cuid())
  userId          String
  name            String   // e.g., "Home Office", "Work Desk", "Study Room"
  location        String?  // Additional description (e.g., "Main bedroom", "Corner office")
  calibrationData String?  // JSON CalibrationData object from posture calibration
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  postureSessions PostureSession[]

  @@index([userId])
}

model DailyStats {
  id                  String   @id @default(cuid())
  userId              String
  date                DateTime // date for these stats (day start)

  // Daily metrics
  postureScore        Int?     // average posture score for the day (0-100)
  sessionCount        Int      @default(0) // number of sessions
  totalDuration       Int      @default(0) // total minutes monitored
  pointsEarned        Int      @default(0) // points earned this day

  // Break metrics
  breaksScheduled     Int      @default(0) // number of breaks that should have occurred
  breaksCompleted     Int      @default(0) // number of breaks completed
  breaksSnoozed       Int      @default(0) // number of breaks snoozed
  breaksSkipped       Int      @default(0) // number of breaks skipped

  // Posture quality breakdown (minutes)
  timeExcellent       Int      @default(0) // minutes in excellent posture
  timeGood            Int      @default(0) // minutes in good posture
  timeFair            Int      @default(0) // minutes in fair posture
  timePoor            Int      @default(0) // minutes in poor posture

  // Streak status
  dailyGoalMet        Boolean  @default(false)
  breakGoalMet        Boolean  @default(false)

  // Problem areas (JSON)
  problemAreas        String?  // JSON object with frequency by body part

  // Best session of the day
  bestSessionScore    Int?     // highest scoring session
  bestSessionId       String?  // reference to that session

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model PairedDevice {
  id              String   @id @default(cuid())
  userId          String
  deviceId        String   @unique // unique identifier from mobile app
  deviceName      String   // e.g., "iPhone 14 Pro", "Samsung Galaxy S23"
  deviceType      String   // ios, android
  pairingCode     String   @unique // temporary code used for pairing
  fcmToken        String?  // Firebase Cloud Messaging token for push notifications
  isActive        Boolean  @default(true)
  lastSyncedAt    DateTime @default(now())
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pairingCode])
}